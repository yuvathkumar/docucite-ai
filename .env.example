# Copy this file to .env and fill in real values. Never commit .env.

# SQLite file inside instance/ (created automatically)
DATABASE_URL=sqlite:///instance/docucite.db

# "gemini" or "ollama"
LLM_PROVIDER=gemini

# Gemini API free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash

# Embedding model (must match the provider; a Gemini model name for gemini)
EMBED_MODEL=gemini-embedding-001

# PDF ingestion
MAX_UPLOAD_MB=20
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=200

# Ollama (local, free); only used if LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Login: SECRET_KEY signs session cookies (generate a long random string).
# The first admin is created from ADMIN_USERNAME / ADMIN_PASSWORD when no users exist.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
